# -----------------------------------------------------------------------------
# PatSight / OPS authentication (see PatSight product documentation)
# -----------------------------------------------------------------------------
# Required for API calls unless PATSIGHT_TOKEN is set and still valid.
# Aliases: PATSIGHT_ACCOUNT / PATSIGHT_PASSWORD
PATSIGHT_OPS_ACCOUNT=
PATSIGHT_OPS_PASSWORD=

# Optional: skip password login when the token is still accepted by OPS
# PATSIGHT_TOKEN=

# -----------------------------------------------------------------------------
# API hosts (optional — defaults shown)
# -----------------------------------------------------------------------------
# Patent API base URL = {PATSIGHT_URL}/patent/api
# PATSIGHT_URL=https://patent.xinsight-ai.com
# OPS token: {OPS_URL}/api/v2/public/token
# OPS verify: {OPS_URL}/api/public/token/verify
# OPS_URL=https://xops.xtalpi.com

# -----------------------------------------------------------------------------
# Local paths (optional — xcli defaults apply if unset)
# -----------------------------------------------------------------------------
# SQLite: token cache and job metadata (legacy alias: PATSIGHT_CLIENT_DB)
# XCLI_CLIENT_DB=~/.local/share/xcli/tasks.db

# Exported CSV and similar outputs (legacy alias: PATSIGHT_WORKDIR)
# XCLI_WORKDIR=~/.local/share/xcli/output
